From ee75a6b222269c4574f498a06832a24b2ff0cf6a Mon Sep 17 00:00:00 2001
From: windowsair <dev@airkyi.com>
Date: Sat, 10 May 2025 19:44:11 +0800
Subject: [PATCH 2/2] Add support for cmsis dap elaphurelink backend

Signed-off-by: windowsair <dev@airkyi.com>
---
 src/jtag/drivers/cmsis_dap.c | 10 +++++++++-
 src/jtag/drivers/cmsis_dap.h |  2 ++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/jtag/drivers/cmsis_dap.c b/src/jtag/drivers/cmsis_dap.c
index a5139dab9..04ddc36fe 100644
--- a/src/jtag/drivers/cmsis_dap.c
+++ b/src/jtag/drivers/cmsis_dap.c
@@ -63,6 +63,7 @@ static const struct cmsis_dap_backend *const cmsis_dap_backends[] = {
 	&cmsis_dap_usb_backend,
 	&cmsis_dap_hid_backend,
 	&cmsis_dap_tcp_backend,
+	&cmsis_dap_elaphurelink_backend,
 };
 
 /* USB Config */
@@ -2247,7 +2248,7 @@ static const struct command_registration cmsis_dap_subcommand_handlers[] = {
 		.handler = &cmsis_dap_handle_backend_command,
 		.mode = COMMAND_CONFIG,
 		.help = "set the communication backend to use (USB bulk or HID, or TCP).",
-		.usage = "(auto | usb_bulk | hid | tcp)",
+		.usage = "(auto | usb_bulk | hid | tcp | elaphurelink)",
 	},
 	{
 		.name = "quirk",
@@ -2274,6 +2275,13 @@ static const struct command_registration cmsis_dap_subcommand_handlers[] = {
 		.usage = "<cmd>",
 	},
 #endif
+	{
+		.name = "elaphurelink",
+		.chain = cmsis_dap_elaphurelink_subcommand_handlers,
+		.mode = COMMAND_ANY,
+		.help = "elaphurelink commands",
+		.usage = "<cmd>",
+	},
 	COMMAND_REGISTRATION_DONE
 };
 
diff --git a/src/jtag/drivers/cmsis_dap.h b/src/jtag/drivers/cmsis_dap.h
index d2b848941..cc890b224 100644
--- a/src/jtag/drivers/cmsis_dap.h
+++ b/src/jtag/drivers/cmsis_dap.h
@@ -84,8 +84,10 @@ struct cmsis_dap_backend {
 extern const struct cmsis_dap_backend cmsis_dap_hid_backend;
 extern const struct cmsis_dap_backend cmsis_dap_usb_backend;
 extern const struct cmsis_dap_backend cmsis_dap_tcp_backend;
+extern const struct cmsis_dap_backend cmsis_dap_elaphurelink_backend;
 extern const struct command_registration cmsis_dap_usb_subcommand_handlers[];
 extern const struct command_registration cmsis_dap_tcp_subcommand_handlers[];
+extern const struct command_registration cmsis_dap_elaphurelink_subcommand_handlers[];
 
 #define REPORT_ID_SIZE   1
 
-- 
